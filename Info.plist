<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>SUFeedURL</key>
    <string>https://github.com/master-x9/MacDeck/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>nuBQh0s3imCd8yvxHd+gOzrqV4mUOIZ3GDxRDXnHhyA=</string>
    <key>SUScheduledCheckInterval</key>
    <integer>3600</integer>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>CFBundleDisplayName</key>
    <string>MacDeck</string>
    <key>CFBundleName</key>
    <string>MacDeck</string>
    <!-- Local network permission prompt string.
         Without this key the system will not show the local-network
         permission dialog, and Bonjour advertising silently fails. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>MacDeck needs local network access to discover and connect to your phone over Wi-Fi so it can receive deck tile commands.</string>

    <!-- Bonjour service types this app advertises / browses.
         Must include the _macdeck._tcp service type used by
         DeckNetworkManager's NWListener.Service. -->
    <key>NSBonjourServices</key>
    <array>
        <string>_macdeck._tcp</string>
    </array>

    <!-- AppleEvents permission prompt string.
         Required to use NSAppleScript to control System Events
         for reliable global hotkey injection. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>MacDeck requires permission to control System Events in order to simulate global keyboard shortcuts.</string>
</dict>
</plist>
